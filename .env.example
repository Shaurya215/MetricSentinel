# MetricSentinel — environment template.
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every variable below has a working default in core/settings.py, so the
# skeleton runs even with no `.env` file at all.

# ---- Application ----
# local | ci | demo
APP_ENV=local
DEBUG=false

# ---- Logging (NFR-017) ----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json for production and CI, console for readable local output
LOG_FORMAT=json

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- UI ----
UI_PORT=8501

# ---- Application database: PostgreSQL + pgvector ----
# Inside Docker Compose the host is the service name `postgres`; on the host machine it is localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metricsentinel
POSTGRES_USER=metricsentinel
# Local development only. Use a real secret for any deployment (Phase 9).
POSTGRES_PASSWORD=metricsentinel

# ---- Analytics warehouse: DuckDB (Phase 2) ----
DUCKDB_PATH=data/warehouse/warehouse.duckdb

# ---- Experiment tracking (Phase 3) ----
MLFLOW_TRACKING_URI=file://./mlruns

# ---- Models (Phase 4) ----
# Gemini free tier: https://aistudio.google.com/apikey — leave empty until Phase 4.
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# NFR-003: true runs the whole loop with local models only.
OFFLINE_MODE=false
